{
  "manifest_version": 3,
  "name": "Pixelpush",
  "description": "Inspect and tweak any page, audit its design, or capture an element and file it to Linear, with your own AI model.",
  "version": "2.1.0",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/andrewr303/pixelpush",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Pixelpush",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "capture/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open the Pixelpush menu"
    },
    "capture-element": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Capture an element for Linear"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture an area for Linear"
    },
    "capture-window": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Capture the full window for Linear"
    }
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "chrome://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "capture/page-hook.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "content-scripts/audit.js",
        "content-scripts/inspector.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audit/detect.js",
        "schema/annotation.v1.1.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "capture/composer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
