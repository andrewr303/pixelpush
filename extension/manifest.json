{
  "manifest_version": 3,
  "name": "Pixelpush",
  "description": "Inspect and tweak any page, audit its design, then file the fix to Linear with your own AI model.",
  "version": "2.1.0",
  "minimum_chrome_version": "114",
  "homepage_url": "https://github.com/andrewr303/pixelpush",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Pixelpush",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "optional_permissions": [
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "js": [
        "content-scripts/audit.js",
        "content-scripts/inspector.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "audit/detect.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
